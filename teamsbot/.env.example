MICROSOFT_APP_ID=your-app-id-here
MICROSOFT_APP_PASSWORD=your-app-password-here
PORT=3978

# Dein Server-Hostname (z.B. bot.monsterjagd.minich.at)
BOT_HOSTNAME=bot.monsterjagd.minich.at

# Duolingo Usernames (kommagetrennt)
DUOLINGO_USERS=username1,username2,username3

# Teams Channel ID für automatische Duolingo-Updates
DUOLINGO_CHANNEL_ID=your-channel-id
DUOLINGO_TEAM_ID=your-team-id

# Cron-Schedule für Duolingo Updates (Standard: täglich 20:00)
DUOLINGO_CRON=0 20 * * *
